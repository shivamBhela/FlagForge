# ==============================================================================
# FlagForge Environment Configuration
# ==============================================================================

# Core Application
APP_ENV=development
APP_NAME=FlagForge
APP_SECRET_KEY=generate-a-strong-random-secret-key-at-least-32-chars
ENCRYPTION_KEY=tU_hQ8z2fPj_eL7_X0v9Y4kW3rA6mB1nC5sD8eF2gH4=
API_PORT=8000
WEB_PORT=3000

# Base URLs
WEB_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://flagforge:flagforge_password@postgres:5432/flagforge
POSTGRES_DB=flagforge
POSTGRES_USER=flagforge
POSTGRES_PASSWORD=flagforge_password
POSTGRES_PORT=5432

# Redis (Queue, Locks, Cache)
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379

# Flagsmith Integration
FLAGSMITH_BASE_URL=https://edge.api.flagsmith.com/api/v1
# Note: Management tokens should be saved via UI securely encrypted in DB,
# but an optional default management token can be specified here:
FLAGSMITH_DEFAULT_MANAGEMENT_TOKEN=

# GitHub App Integration (Optional for Repository Scanning)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# AI Explanation Provider (Optional - works fully in deterministic fallback if omitted)
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Safety & Policies
AUTO_ROLLBACK_DEFAULT=false
MAX_ROLLBACK_ATTEMPTS=2
ROLLBACK_COOLDOWN_SECONDS=600
