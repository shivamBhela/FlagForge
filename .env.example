# ==============================================================================
# FlagForge Environment Configuration
# ==============================================================================

# Core Application (setup.ps1 generates unique local secrets in .env.)
COMPOSE_PROJECT_NAME=flagforge
APP_ENV=development
APP_NAME=FlagForge
APP_SECRET_KEY=GENERATE_WITH_SETUP_PS1
ENCRYPTION_KEY=GENERATE_WITH_SETUP_PS1
API_PORT=8000
WEB_PORT=3000
DEMO_APP_PORT=8080

# Base URLs
WEB_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://flagforge:GENERATE_WITH_SETUP_PS1@postgres:5432/flagforge
POSTGRES_DB=flagforge
POSTGRES_USER=flagforge
POSTGRES_PASSWORD=GENERATE_WITH_SETUP_PS1
POSTGRES_PORT=5433

# Redis (Queue, Locks, Cache)
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6380

# Official self-hosted Flagsmith (the local Compose service is the competition default).
# Use the Docker service name from the FlagForge API container, not localhost.
FLAGSMITH_BASE_URL=http://flagsmith:8000/api/v1
FLAGSMITH_ALLOWED_HOSTS=["flagsmith"]
FLAGSMITH_PORT=8081
FLAGSMITH_DOMAIN=localhost:8081
FLAGSMITH_IMAGE=docker.flagsmith.com/flagsmith/flagsmith:2.295.2@sha256:48905c664152d8ae2c843ec9cee72ff197e7caff6e91b959bb851a235915ea35
FLAGSMITH_POSTGRES_PASSWORD=GENERATE_WITH_SETUP_PS1
FLAGSMITH_DJANGO_SECRET_KEY=GENERATE_WITH_SETUP_PS1
FLAGSMITH_WAREHOUSE_CREDENTIALS_SECRET=GENERATE_WITH_SETUP_PS1
# Lower the official Flagsmith API worker count for small local Docker memory budgets.
FLAGSMITH_GUNICORN_WORKERS=1
# Fill this from the dedicated Flagsmith Development environment only if the demo app should evaluate live flags.
FLAGSMITH_ENVIRONMENT_KEY=

# Optional GitHub App setup for organization-scoped repository access.
# The app must be installed on the intended test repository with only Metadata:read,
# Contents:read/write and Pull requests:write. The API mints installation tokens.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# Generated local-only secret used by the Collector to authenticate telemetry exports to FlagForge.
OTEL_INGEST_TOKEN=GENERATE_WITH_SETUP_PS1
# Set both IDs only for an isolated QA/demo organization and project to receive demo-app telemetry.
FLAGFORGE_TELEMETRY_ORGANIZATION_ID=
FLAGFORGE_TELEMETRY_PROJECT_ID=
FLAGFORGE_TELEMETRY_ENVIRONMENT=staging

# AI Explanation Provider (Optional - works fully in deterministic fallback if omitted)
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Safety & Policies
AUTO_ROLLBACK_DEFAULT=false
MAX_ROLLBACK_ATTEMPTS=2
ROLLBACK_COOLDOWN_SECONDS=600
